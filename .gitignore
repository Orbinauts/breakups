node_modules/
# What `npm run build` and `npm run docs` write.
dist/
reference/
*.tgz
# No lockfile: the package is installed by its ranges, as a consumer's
# project installs it, so CI tests what a consumer gets.
package-lock.json
# Credentials for the Archive's pulls, read from the environment only.
.env
# Where the KPI runner works; its results are committed under kpi/.
kpi/work/
# The per-year scorecard files: tens of megabytes a run, carried by the KPI
# workflow as artifacts and made again by `npm run kpi -- --all`; only the
# aggregate `kpi/latest.{json,md}` is committed.
kpi/years/
